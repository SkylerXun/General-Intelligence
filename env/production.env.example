# Copy to env/production.env on the Linux VPS, replace every placeholder, then chmod 600.
# This file is intentionally not a runnable production configuration.
TZ=Asia/Shanghai

# Build from the fixed commits recorded by the root repository.
NEWAPI_IMAGE=gateway-new-api:prod
SUB2API_IMAGE=gateway-sub2api:prod
# Use an organization-approved Go module proxy if policy requires one.
GO_PROXY=https://goproxy.cn,direct
GO_SUMDB=sum.golang.google.cn

POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
NEWAPI_PG_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
SUB2API_PG_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
NEWAPI_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
SUB2API_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
SUB2API_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
SUB2API_TOTP_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_VALUE

# Public New API portal and private Sub2API administrator host. The admin host
# should be DNS-only (not CDN-proxied) and also restricted by the VPS firewall.
APP_DOMAIN=api.example.cn
ADMIN_DOMAIN=admin-api.example.cn
ADMIN_ALLOWED_CIDRS=203.0.113.10/32
CADDY_EMAIL=ops@example.cn

# Pin the only trusted proxy address, rather than trusting every RFC1918 proxy.
GATEWAY_SUBNET=172.31.250.0/24
CADDY_INTERNAL_IP=172.31.250.10
NEWAPI_TRUSTED_PROXIES=172.31.250.10
NEWAPI_NODE_NAME=gateway-prod-new-api-1
NEWAPI_SESSION_COOKIE_SECURE=true
NEWAPI_SESSION_COOKIE_TRUSTED_URL=https://api.example.cn

SUB2API_ADMIN_EMAIL=admin@example.cn
SUB2API_DB_MAX_OPEN_CONNS=30
SUB2API_DB_MAX_IDLE_CONNS=8
SUB2API_REDIS_POOL_SIZE=128
SUB2API_REDIS_MIN_IDLE_CONNS=4

# Set this to an explicit comma-separated hostname list matching the upstreams
# you operate. Do not use wildcards or private hosts in production.
SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com

REDIS_MAXMEMORY=1gb
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
