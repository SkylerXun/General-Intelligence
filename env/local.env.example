# Copying/generating this file creates a local-only configuration. Do not commit it.
TZ=Asia/Shanghai

# Docker images produced from the fixed git submodule commits.
NEWAPI_IMAGE=gateway-new-api:local
SUB2API_IMAGE=gateway-sub2api:local
GO_PROXY=https://goproxy.cn,direct
GO_SUMDB=sum.golang.google.cn
POSTGRES_LOCAL_IMAGE=postgres:18-alpine

# Loopback-only local access. These do not conflict with the current stack on 3000/8080.
NEWAPI_LOCAL_PORT=3100
SUB2API_LOCAL_PORT=8180

# The init-local.sh script replaces every __GENERATE__ value with a random secret.
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
NEWAPI_PG_PASSWORD=__GENERATE__
SUB2API_PG_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
NEWAPI_SESSION_SECRET=__GENERATE__
SUB2API_ADMIN_PASSWORD=__GENERATE__
SUB2API_JWT_SECRET=__GENERATE__
SUB2API_TOTP_ENCRYPTION_KEY=__GENERATE__

NEWAPI_SESSION_COOKIE_SECURE=false
NEWAPI_SESSION_COOKIE_TRUSTED_URL=
NEWAPI_TRUSTED_PROXIES=none
NEWAPI_NODE_NAME=gateway-local-new-api-1

SUB2API_ADMIN_EMAIL=admin@sub2api.local
SUB2API_DB_MAX_OPEN_CONNS=20
SUB2API_DB_MAX_IDLE_CONNS=5
SUB2API_REDIS_POOL_SIZE=64
SUB2API_REDIS_MIN_IDLE_CONNS=2

# Local testing may use localhost/private test upstreams. Production is stricter.
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=

# 1 GB is a Redis ceiling, not a preallocated reservation.
REDIS_MAXMEMORY=1gb
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
